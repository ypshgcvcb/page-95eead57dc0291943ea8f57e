ound:var(--ink);color:#fff;border-color:var(--ink)}\n.plan .tag{align-self:flex-start;font-size:11.5px;letter-spacing:.2em;font-weight:800;border:2px solid currentColor;padding:3px 9px}\n.plan.pick .tag{border-color:var(--accent);color:#fff;background:var(--accent);border-color:var(--accent)}\n.plan h3{font-size:22px}\n.plan .price{font-size:40px;font-weight:800;letter-spacing:-.04em;line-height:1}\n.plan .price small{font-size:14px;font-weight:600;letter-spacing:0;color:var(--gray);margin-left:6px}\n.plan.pick .price small{color:#b9bcc1}\n.plan .year{font-size:14px;color:var(--gray)}\n.plan.pick .year{color:#c8cbcf}\n.plan ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;font-size:15px}\n.plan li{padding-left:20px;position:relative;line-height:1.6}\n.plan li::before{content:\"\";position:absolute;left:0;top:.62em;width:9px;height:2px;background:var(--accent)}\n.plan.pick li::before{background:#fff}\n.plan-others{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:26px}\n.mini{border:2px solid var(--line);padding:20px 22px}\n.mini h3{font-size:17px;margin-bottom:8px}\n.mini b{font-size:24px;letter-spacing:-.03em}\n.mini b small{font-size:13px;font-weight:600;color:var(--gray);margin-left:4px}\n.mini p{font-size:13.5px;color:var(--gray);margin-top:8px}\n\n/* ---------- 客户端 ---------- */\n.client-row{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}\n.client{border:2px solid var(--line);padding:22px 24px;display:flex;gap:16px;align-items:flex-start}\n.client-badge{flex:0 0 46px;height:46px;border:2px solid var(--line);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;letter-spacing:-.02em}\n.client h3{font-size:16.5px;margin-bottom:4px}\n.client p{font-size:14px;color:var(--gray)}\n\n/* ---------- FAQ 对话气泡 ---------- */\n.chat{display:flex;flex-direction:column;gap:22px;max-width:820px}\n.bubble-q{align-self:flex-start;background:var(--ink);color:#fff;padding:14px 20px;font-weight:700;font-size:15.5px;border-radius:2px;max-width:86%}\n.bubble-a{align-self:flex-end;background:var(--mist);border:2px solid var(--line);padding:16px 20px;font-size:15px;color:var(--ink-soft);max-width:88%}\n.bubble-a b{color:var(--ink)}\n\n/* ---------- 页脚 ---------- */\nfooter{border-top:2px solid var(--line);padding:38px 6vw 54px;display:flex;flex-wrap:wrap;gap:20px 40px;justify-content:space-between;font-size:13.5px;color:var(--gray)}\nfooter strong{color:var(--ink);letter-spacing:.14em;font-size:13px}\nfooter a{color:var(--ink);text-decoration:none;border-bottom:2px solid var(--accent);padding-bottom:1px}\n\n@media (max-width:900px){\n  .shell{flex-direction:column}\n  .side{width:100%;flex:none;border-right:0;border-bottom:2px solid var(--line);flex-direction:row;flex-wrap:wrap;align-items:center;gap:16px 22px;padding:18px 6vw}\n  .side-note{margin:0;border-top:0;padding-top:0;flex:1 1 100%;font-size:12px}\n  .side-nav{flex-direction:row;flex-wrap:wrap;gap:0 4px}\n  .side-nav a{border-left:0;border-bottom:2px solid #d8dade;padding:4px 8px}\n  .side-nav a:hover,.side-nav a:focus{border-left-color:#d8dade;border-bottom-color:var(--accent)}\n  section{padding:56px 6vw}\n  .grid-3,.grid-2,.plans,.plan-others,.client-row{grid-template-columns:1fr}\n  .hero-figures{gap:22px}\n  .step{grid-template-columns:56px 1fr;gap:14px;padding:20px 18px}\n  .step::before{font-size:26px}\n  .bubble-q,.bubble-a{max-width:100%}\n}\n</style><div class=\"shell\">\n\n  <aside class=\"side\">\n    <div class=\"side-mark\">猫咪火箭<span class=\"dot\">·</span>云</div>\n    <nav class=\"side-nav\" aria-label=\"目录\">\n      <a href=\"#plans\">套餐选择</a>\n      <a href=\"#howto\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#notes\">订阅须知</a>\n    </nav>\n    <div class=\"side-note\">\n      这里是一份写给普通人的说明书。先看你需要多少，再决定付多少，不必一步到位。\n    </div>\n  </aside>\n\n  <div class=\"content\">\n    <main>\n\n      <section class=\"hero\" id=\"top\">\n        <div class=\"wrap\">\n          <div class=\"hero-kicker\">\n            <span>产品说明</span>\n            <span>套餐与使用</span>\n            <span>常见问题</span>\n          </div>\n          <h1>猫咪火箭<em>云</em></h1>\n          <div class=\"hero-tail\">\n            <p class=\"hero-lead\">\n              我们把「挑一个订阅」这件事拆成三段：看清楚自己每月用多少、装好客户端、遇到问题知道去哪儿找答案。下面三块内容按这个顺序写，你顺着读就行。\n            </p>\n            <div class=\"hero-figures\">\n              <div class=\"figure\"><b>3</b><small>档价格档位</small></div>\n              <div class=\"figure\"><b>4</b><small>类客户端说明</small></div>\n              <div class=\"figure\"><b>2</b><small>组常见问答</small></div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"plans\">\n        <div class=\"wrap\">\n          <div class=\"sec-head\">\n            <div class=\"sec-num\">01</div>\n            <h2>套餐：先比两块，再看整张表</h2>\n          </div>\n          <p class=\"sec-sub\">\n            大多数人真正纠结的只有两件事——流量够不够、几台设备一起用。所以先把基础版和旗舰版并排放出来，剩下的团队版放在下面补一句。\n          </p>\n\n          <div class=\"plans\">\n            <article class=\"plan\">\n              <span class=\"tag\">入门</span>\n              <h3>基础版</h3>\n              <div class=\"price\">¥15<small>/月</small></div>\n              <div class=\"year\">按年付 ¥150/年</div>\n              <ul>\n                <li>每月 100GB 流量</li>\n                <li>3 台设备同时在线</li>\n                <li>基础流媒体解锁</li>\n                <li>普通线路节点池</li>\n              </ul>\n            </article>\n\n            <article class=\"plan pick\">\n              <span class=\"tag\">多数人选这个</span>\n              <h3>旗舰版</h3>\n              <div class=\"price\">¥35<small>/月</small></div>\n              <div class=\"year\">按年付 ¥350/年</div>\n              <ul>\n                <li>每月 300GB 流量</li>\n                <li>5 台设备同时在线</li>\n                <li>全节点原生流媒体解锁</li>\n                <li>IPLC 专线游戏加速优化</li>\n                <li>7×24 优先工单支持</li>\n              </ul>\n            </article>\n          </div>\n\n          <div class=\"plan-others\">\n            <article class=\"mini\">\n              <h3>团队版</h3>\n              <b>¥85<small>/月</small></b>\n              <p>按年付 ¥850/年。每月 1000GB、20 台设备同时在线，含 VIP 专属高带宽节点、企业定制路由与专属客户经理服务。</p>\n            </article>\n            <article class=\"mini\">\n              <h3>怎么选不纠结</h3>\n              <p>只在一台手机和一台电脑之间切换，基础版够用；手机、平板、电视盒子一起挂，旗舰版更省心；要给一间办公室分账号，才考虑团队版。</p>\n            </article>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"howto\">\n        <div class=\"wrap\">\n          <div class=\"sec-head\">\n            <div class=\"sec-num\">02</div>\n            <h2>使用说明：四步就位</h2>\n          </div>\n          <p class=\"sec-sub\">下单之后不用研究术语，照着这四步做，每一步都能自己检查是否成功。</p>\n\n          <div class=\"steps\">\n            <div class=\"step\">\n              <div>\n                <h3>确认你的用量，再定档位</h3>\n                <p>翻一下手机流量统计，把视频、下载、日常浏览分开看。如果一个月里有一半时间在通勤路上刷视频，往高流量那档放；如果只是偶尔查资料、收发文件，低档位更合适。</p>\n              </div>\n            </div>\n            <div class=\"step\">\n              <div>\n                <h3>装一个和你系统对得上的客户端</h3>\n                <p>客户端按系统分类，不是按品牌分类。先看清自己手上是手机、电脑还是电视盒子，再去对应那一栏。装完先别急着连，确认版本号和系统版本没有明显错配。</p>\n              </div>\n            </div>\n            <div class=\"step\">\n              <div>\n                <h3>导入订阅信息，别手工敲</h3>\n                <p>把订阅信息整段复制进客户端，比逐项手填稳得多。复制时注意不要漏掉结尾的字符，导入后先看列表是否正常显示，数量对不上通常就是复制不全。</p>\n              </div>\n            </div>\n            <div class=\"step\">\n              <div>\n                <h3>连一次，再核对两件事</h3>\n                <p>第一次连接成功后，先看当前使用的线路是不是你想用的那条，再看设备数有没有超过档位允许的同时在线数量。两件事都对，就可以正常用了；不对，回到上一步重导一次。</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"clients\">\n        <div class=\"wrap\">\n          <div class=\"sec-head\">\n            <div class=\"sec-num\">03</div>\n            <h2>客户端：按系统选，不按品牌选</h2>\n          </div>\n          <p class=\"sec-sub\">\n            具体可用版本以你系统能安装的为准。下载入口请以官方页面提供的信息为准，本站不提供直接下载地址。\n          </p>\n\n          <div class=\"client-row\">\n            <article class=\"client\">\n              <div class=\"client-badge\">iOS</div>\n              <div>\n                <h3>iPhone / iPad</h3>\n                <p>从系统应用商店按名称查找，安装后通过订阅信息导入配置。首次打开通常需要允许添加配置，选择允许即可。</p>\n              </div>\n            </article>\n            <article class=\"client\">\n              <div class=\"client-badge\">安卓</div>\n              <div>\n                <h3>Android 手机与平板</h3>\n                <p>安装包来源以官方页面为准。安装时系统可能提示未知来源，确认来源可靠后再允许安装。</p>\n              </div>\n            </article>\n            <article class=\"client\">\n              <div class=\"client-badge\">桌面</div>\n              <div>\n                <h3>Windows / macOS</h3>\n                <p>桌面端适合同时挂多个窗口的场景，安装后从托盘或菜单栏启动，订阅信息粘贴进去即可，不需要逐条配置。</p>\n              </div>\n            </article>\n            <article class=\"client\">\n              <div class=\"client-badge\">路由</div>\n              <div>\n                <h3>路由器与其他设备</h3>\n                <p>这一步涉及设备本身的设置，不同固件差异较大。请先确认设备支持的能力，再按对应系统的说明操作。</p>\n              </div>\n            </article>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"faq\">\n        <div class=\"wrap\">\n          <div class=\"sec-head\">\n            <div class=\"sec-num\">04</div>\n            <h2>常见问题：有人问过，我们答过</h2>\n          </div>\n          <p class=\"sec-sub\">两组问题，一组关于选择，一组关于使用中的小状况。</p>\n\n          <div class=\"chat\">\n            <div class=\"bubble-q\">第一次买，15 块和 35 块到底差在哪？</div>\n            <div class=\"bubble-a\">\n              差三件事：<b>流量</b>从每月 100GB 到 300GB，<b>同时在线设备</b>从 3 台到 5 台，以及线路类型——旗舰版包含 IPLC 专线游戏加速优化和全节点原生流媒体解锁。如果你只是偶尔用，基础版不会让你难受；如果家里好几台设备一起挂着，旗舰版省下的是折腾。\n            </div>\n\n            <div class=\"bubble-q\">能不能先按年付，后面再改档？</div>\n            <div class=\"bubble-a\">\n              年付价格更低，适合已经确定自己用量的人。还没想清楚的阶段，建议先按月走一个周期，把自己真实的用量看清楚，再决定要不要换成年付或换档位。具体变更规则请以官方页面的说明为准。\n            </div>\n\n            <div class=\"bubble-q\">装好客户端之后连不上，先看哪里？</div>\n            <div class=\"bubble-a\">\n              按顺序排查最省时间：<b>一</b>，订阅信息是否完整复制；<b>二</b>，当前选中的线路在列表里是否正常出现；<b>三</b>，是不是已经达到档位允许的同时在线设备数。这三项都对，再去看客户端本身是否需要更新。\n            </div>\n\n            <div class=\"bubble-q\">同时在线设备数是怎么算的？</div>\n            <div class=\"bubble-a\">\n              按<b>同一时间连接着的设备数量</b>算，不是按你的账号里记录过几台设备。基础版 3 台、旗舰版 5 台、团队版 20 台。手机超过数量时可以先把不用的那台断开，再连新的。\n            </div>\n\n            <div class=\"bubble-q\">团队版适合什么样的使用场景？</div>\n            <div class=\"bubble-a\">\n              适合几个人共用一套配置、又需要分开管理的场景，比如一间小办公室。它包含 VIP 专属高带宽节点和企业定制路由，也配有专属客户经理。只有一两个人用，通常不需要走到这一档。\n            </div>\n\n            <div class=\"bubble-q\">流量用完了会怎样？</div>\n            <div class=\"bubble-a\">\n              每个档位都有对应的月度流量额度。建议在客户端里留意用量显示，接近上限时提前决定是等到下个周期，还是调整到更高档位。具体处理方式以官方说明为准。\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"notes\">\n        <div class=\"wrap\">\n          <div class=\"sec-head\">\n            <div class=\"sec-num\">05</div>\n            <h2>订阅须知</h2>\n          </div>\n          <div class=\"grid-3\">\n            <article class=\"card\">\n              <h3>价格只是标价</h3>\n              <p>页面上列出的月付与年付价格，用于帮助你比较档位差异。实际结算信息以下单页面显示为准。</p>\n            </article>\n            <article class=\"card\">\n              <h3>下载地址不在此页</h3>\n              <p>客户端获取渠道请以官方页面提供的信息为准，本站不代为分发安装包，也不提供直接下载链接。</p>\n            </article>\n            <article class=\"card\">\n              <h3>没有承诺的效果数字</h3>\n              <p>这里不写测速结论，也不列举节点清单。你看到的每一条，都是可以被你自行验证的使用步骤。</p>\n            </article>\n          </div>\n        </div>\n      </section>\n\n    </main>\n\n    <footer>\n      <div>\n        <strong>猫咪火箭云</strong><br>\n        一份写给普通人的订阅说明书\n      </div>\n      <div>\n        回到 <a href=\"#top\">页面顶部</a> · <a href=\"#faq\">常见问题</a>\n      </div>\n    </footer>\n  </div>\n\n</div>",
